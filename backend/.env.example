# ── Database ──────────────────────────────────────────────────────────────────
# Railway PostgreSQL injects DATABASE_URL automatically.
# For local dev use: postgresql://postgres:admin@localhost:5432/atomquest
DATABASE_URL=postgresql://postgres:admin@localhost:5432/atomquest

# ── Auth ───────────────────────────────────────────────────────────────────────
# Change this to a long random string in production.
JWT_SECRET=atomquest-dev-secret-change-in-prod

# Token lifespan — 8 hours is comfortable for a working day.
# When it expires the frontend redirects to /login automatically (Fix 2).
JWT_EXPIRES_IN=8h

# ── CORS (Fix 1) ──────────────────────────────────────────────────────────────
# Set to your Vercel/Netlify URL in production.
# Leave blank or unset for local dev (localhost:3000 is always allowed).
FRONTEND_URL=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
